# ---- Server ----
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of origins allowed to call the API from a browser.
# Use the origin(s) where your docs are served. "*" allows any (dev only).
ALLOWED_ORIGINS=*
# Public base URL where this server is reachable (used by the standalone page).
PUBLIC_BASE_URL=http://localhost:8000

# ---- Storage backend ----
# "pgvector" = PostgreSQL + pgvector (production default).
# "local"    = NumPy file store, no database server required (see "Local mode" below).
VECTOR_STORE=pgvector
# Path for the local NumPy store (only used when VECTOR_STORE=local).
LOCAL_STORE_PATH=data/index.pkl

# ---- Database (PostgreSQL + pgvector; used when VECTOR_STORE=pgvector) ----
PGHOST=localhost
PGPORT=5432
PGDATABASE=docs_bot
PGUSER=docs_bot
PGPASSWORD=change-me

# ---- Embedding backend ----
# "sentence_transformers" = local BGE models via PyTorch (production default).
# "ollama"                = embeddings served by Ollama, no PyTorch needed.
EMBED_BACKEND=sentence_transformers
# Model used when EMBED_BACKEND=ollama (run: ollama pull nomic-embed-text).
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Embeddings / Reranker (used when EMBED_BACKEND=sentence_transformers) ----
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-base
# Prefix recommended by BGE models for retrieval queries.
QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# ---- Local mode (no Postgres, no PyTorch) ----
# To run with only Ollama (no database, no torch), set:
#   VECTOR_STORE=local
#   EMBED_BACKEND=ollama
#   OLLAMA_EMBED_MODEL=nomic-embed-text
# and install the lightweight deps: pip install -r requirements-lite.txt

# ---- LLM (local, via Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192

# ---- Retrieval ----
RETRIEVE_TOP_K=20
RERANK_TOP_N=6

# ---- Private-context codegen security (demo) ----
ENABLE_PRIVATE_CODE_ENCRYPTION=true
ENCRYPTION_KEY_ID=demo-key

# ---- Private source credentials (examples for sources.yaml auth_ref/auth_type) ----
# Bearer or raw token references (used by auth_ref)
PRIVATE_SOURCE_TOKEN_DOCS=
PRIVATE_SOURCE_TOKEN_REPO=
# Basic auth examples (used by auth_user_env/auth_pass_env)
PRIVATE_SOURCE_USER_DOCS=
PRIVATE_SOURCE_PASS_DOCS=

# ---- Branding ----
APP_NAME=KnowledgeAssist
